# Environment Variables Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to git - it contains secrets!

# =============================================================================
# SECURITY
# =============================================================================

# JWT Secret Key - used for signing authentication tokens
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# IMPORTANT: Use a different secret in production!
SECRET_KEY=your-secret-key-change-this-in-production

# =============================================================================
# DATABASE
# =============================================================================

# Database connection URL
#
# Local Development (SQLite):
#   DATABASE_URL=sqlite:///./boggle.db
#
# Production (PostgreSQL on Fly.io or other platforms):
#   DATABASE_URL=postgresql://user:password@host:port/database
#
# Note: Many platforms (like Fly.io) automatically set DATABASE_URL
DATABASE_URL=sqlite:///./boggle.db
