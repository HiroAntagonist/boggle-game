{
  // ABOUTME: VSCode workspace settings for the Boggle project
  // ABOUTME: Configures Python, Pylance, testing, and formatting for optimal development experience

  // Python Configuration
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  
  // Pylance (Type Checking)
  "python.analysis.typeCheckingMode": "basic",
  "python.analysis.autoImportCompletions": true,
  "python.analysis.diagnosticMode": "workspace",
  
  // Testing
  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,
  "python.testing.pytestArgs": [
    "tests"
  ],
  "python.testing.autoTestDiscoverOnSaveEnabled": true,
  
  // Editor Formatting
  "editor.formatOnSave": false,  // We'll enable this later with a formatter
  "editor.rulers": [88, 120],  // Line length guides
  "editor.tabSize": 4,
  "editor.insertSpaces": true,
  
  // File Associations
  "files.exclude": {
    "**/__pycache__": true,
    "**/*.pyc": true,
    "**/.pytest_cache": true,
    "**/.mypy_cache": true,
    "**/.venv": false  // Show venv folder but grayed out
  },
  
  // Git
  "git.autofetch": true,
  "git.confirmSync": false,
  
  // Terminal
  "terminal.integrated.defaultProfile.osx": "fish",  // Use your fish shell
  "terminal.integrated.env.osx": {
    "PYTHONPATH": "${workspaceFolder}/src"
  },
  
  // Helpful Features
  "editor.codeActionsOnSave": {
    "source.organizeImports": "never"  // We'll control this manually
  },
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  
  // Disable telemetry (privacy)
  "telemetry.telemetryLevel": "off"
}
